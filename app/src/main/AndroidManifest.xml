<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="id.neotica.orpheum">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:name=".OrpheumApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity android:name=".feature.home.ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".feature.auth.login.ui.LoginActivity" />
        <activity android:name=".feature.auth.forgotpassword.ui.ForgotPasswordActivity" />
        <activity android:name=".feature.auth.register.ui.RegisterActivity" />
        <activity android:name=".feature.settings.ui.SettingsActivity" />
        <activity android:name=".feature.trackfeed.ui.TrackFeedActivity" />
        <activity android:name=".feature.albumfeed.ui.AlbumFeedActivity" />
        <activity
            android:name=".feature.search.ui.SearchActivity"
            android:windowSoftInputMode="stateHidden" />
        <activity android:name=".feature.albumdetail.ui.AlbumDetailActivity" />
        <activity android:name=".feature.downloads.ui.DownloadsActivity" />
        <activity android:name=".feature.radio.ui.RadioActivity" />
        <activity android:name=".feature.player.ui.PlayerActivity" />

        <service
            android:name=".feature.player.service.AudioService"
            android:exported="false" />

        <service
            android:name=".feature.downloads.service.DownloadService"
            android:exported="false" />

        <receiver
            android:name=".feature.player.service.NotificationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="id.neotica.orpheum.action.PLAY_PAUSE" />
                <action android:name="id.neotica.orpheum.action.NEXT" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
