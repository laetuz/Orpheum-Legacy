<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/top_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subsonic_prompt"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/et_subsonic_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/subsonic_server_hint"
            android:singleLine="true"
            android:inputType="textUri"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/et_subsonic_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/common_username"
            android:singleLine="true"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/et_subsonic_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/common_password"
            android:singleLine="true"
            android:inputType="textPassword"
            android:drawableRight="@drawable/ic_eye_closed"
            android:drawablePadding="8dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_subsonic_connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subsonic_connect" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subsonic_credentials_note"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</LinearLayout>
